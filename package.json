{
  "name": "web-app-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Secure, privacy-first, local-first Vue web application template for agentic development.",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "node scripts/run-python.mjs scripts/check-format.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "docs:generate": "node scripts/run-python.mjs scripts/generate-docs.py",
    "docs:check": "node scripts/run-python.mjs scripts/check-docs.py",
    "openspec:check": "node scripts/run-python.mjs scripts/check-openspec.py",
    "privacy:check": "node scripts/run-python.mjs scripts/check-privacy.py",
    "architecture:check": "node scripts/run-python.mjs scripts/check-architecture.py",
    "security:check": "node scripts/run-python.mjs scripts/check-security-config.py",
    "template:validate": "node scripts/run-python.mjs scripts/validate-template.py",
    "template:test": "node scripts/run-python.mjs -m unittest discover -s scripts/tests -p test_*.py",
    "version:check": "node scripts/run-python.mjs scripts/check-versioning.py",
    "template:init": "node scripts/run-python.mjs scripts/init-template.py",
    "hooks:install": "node scripts/install-hooks.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/run-python.mjs scripts/check-licenses.py",
    "package:source": "node scripts/run-python.mjs scripts/package-source.py",
    "package:release": "node scripts/run-python.mjs scripts/package-release.py",
    "clean": "node scripts/cleanup-local.mjs artifacts",
    "clean:dry-run": "node scripts/cleanup-local.mjs all --dry-run",
    "clean:docker": "node scripts/cleanup-local.mjs docker",
    "clean:all": "node scripts/cleanup-local.mjs all",
    "clean:deep": "node scripts/cleanup-local.mjs all --include-node-modules",
    "clean:docker:unused": "node scripts/cleanup-local.mjs docker-unused",
    "artifact:check": "node scripts/run-local-workflow.mjs artifact",
    "dependencies:check": "node scripts/check-dependencies.mjs",
    "verify:fast": "npm run format:prettier-check && npm run lint && npm run typecheck && npm run test",
    "verify": "npm run verify:fast && npm run structured:check && npm run workflow:check && npm run template:validate && npm run template:test && npm run version:check && npm run agents:check && npm run docs:check && npm run help:check && npm run openspec:check && npm run privacy:check && npm run architecture:check && npm run security:check && npm run licenses:generate && npm run licenses:check",
    "ci": "npm run verify && npm run build && npm run test:e2e && npm run audit",
    "prepare": "node scripts/install-hooks.mjs",
    "audit": "npm audit --audit-level=high",
    "format:prettier-check": "prettier --check .",
    "agents:check": "node scripts/run-python.mjs scripts/check-agent-customizations.py",
    "structured:check": "node scripts/check-structured-data.mjs",
    "workflow:install": "node scripts/run-local-workflow.mjs install",
    "workflow:prepare": "node scripts/run-local-workflow.mjs prepare",
    "workflow:ci": "node scripts/run-local-workflow.mjs ci",
    "workflow:pages": "node scripts/run-local-workflow.mjs pages",
    "workflow:dependency-review": "node scripts/run-local-workflow.mjs dependencies",
    "workflow:security": "node scripts/run-local-workflow.mjs security",
    "workflow:repository": "node scripts/run-local-workflow.mjs repository",
    "workflow:release": "node scripts/run-local-workflow.mjs release",
    "workflow:portable": "node scripts/run-local-workflow.mjs portable",
    "workflow:local": "node scripts/run-local-workflow.mjs all",
    "workflow:check": "node scripts/check-workflow-parity.mjs",
    "devcontainer:verify": "node scripts/run-local-workflow.mjs container",
    "help:render": "node scripts/run-python.mjs .lumbrecode/tooling/docs/render_app_help.py --repo . --out src/presentation/help --target app",
    "help:check": "node scripts/run-python.mjs .lumbrecode/tooling/docs/render_app_help.py --repo . --out src/presentation/help --target app --check",
    "screenshots:capture": "playwright test --project=screenshots"
  },
  "dependencies": {
    "dexie": "4.4.5",
    "pinia": "3.0.4",
    "vue": "3.5.41",
    "vue-i18n": "11.4.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@devcontainers/cli": "0.88.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/tsconfig": "0.9.1",
    "daisyui": "5.7.16",
    "eslint": "9.39.5",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-vue": "10.10.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9",
    "yaml": "2.9.0"
  }
}
