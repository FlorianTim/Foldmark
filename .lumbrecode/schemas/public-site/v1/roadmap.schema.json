{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumbrecode.de/schemas/public-site/v1/roadmap.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "appSlug",
    "updatedAt",
    "disclaimer",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "appSlug": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "disclaimer": {
      "type": "object",
      "required": [
        "de",
        "en"
      ],
      "properties": {
        "de": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "status",
          "category",
          "public"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "object",
            "required": [
              "de",
              "en"
            ],
            "properties": {
              "de": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "description": {
            "type": "object",
            "required": [
              "de",
              "en"
            ],
            "properties": {
              "de": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "status": {
            "enum": [
              "considering",
              "planned",
              "in_progress",
              "testing",
              "released",
              "postponed"
            ]
          },
          "targetRelease": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": "string"
          },
          "public": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
