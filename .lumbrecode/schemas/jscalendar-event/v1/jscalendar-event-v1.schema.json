{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumbrecode.de/schemas/jscalendar-event/v1/jscalendar-event-v1.schema.json",
  "title": "LumbreCode JSCalendar Event subset v1",
  "description": "Validates the subset of RFC 8984 JSCalendar Event that LumbreCode apps emit. Stricter than RFC 8984 on what may be EMITTED; receivers must still read tolerantly and keep unknown properties. The $defs are deliberately duplicated from the jscalendar-task schema so each schema file is self-contained and independently testable.",

  "$ref": "#/$defs/Event",

  "$defs": {

    "UTCDateTime": {
      "type": "string",
      "description": "RFC 3339 date-time in UTC, second precision, always ending in Z.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },

    "LocalDateTime": {
      "type": "string",
      "description": "RFC 8984 LocalDateTime: wall-clock, NO offset and NO Z.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },

    "Duration": {
      "type": "string",
      "description": "ISO 8601 duration, non-negative.",
      "pattern": "^P(?!$)([0-9]+W)?([0-9]+D)?(T(?!$)([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$"
    },

    "Uid": {
      "type": "string",
      "description": "RFC 4122 version 4 UUID, canonical lowercase form.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },

    "Relation": {
      "type": "object",
      "properties": {
        "@type": { "const": "Relation" },
        "relation": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "enum": ["parent", "child", "first", "next"] },
          "additionalProperties": { "const": true }
        }
      },
      "required": ["@type", "relation"],
      "additionalProperties": false
    },

    "Link": {
      "type": "object",
      "properties": {
        "@type": { "const": "Link" },
        "href": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "cid": { "type": "string", "minLength": 1 },
        "contentType": { "type": "string", "minLength": 1, "maxLength": 255 },
        "size": { "type": "integer", "minimum": 0 },
        "rel": { "type": "string", "minLength": 1, "maxLength": 64 },
        "display": { "enum": ["badge", "graphic", "fullsize", "thumbnail"] },
        "title": { "type": "string", "maxLength": 200 }
      },
      "required": ["@type", "href"],
      "additionalProperties": false
    },

    "NDay": {
      "type": "object",
      "properties": {
        "@type": { "const": "NDay" },
        "day": { "enum": ["mo", "tu", "we", "th", "fr", "sa", "su"] },
        "nthOfPeriod": { "type": "integer", "enum": [-1, 1, 2, 3, 4] }
      },
      "required": ["@type", "day"],
      "additionalProperties": false
    },

    "RecurrenceRule": {
      "type": "object",
      "description": "The LumbreCode subset: frequency, interval, byDay, byMonthDay.",
      "properties": {
        "@type": { "const": "RecurrenceRule" },
        "frequency": { "enum": ["daily", "weekly", "monthly", "yearly"] },
        "interval": { "type": "integer", "minimum": 2 },
        "byDay": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/NDay" } },
        "byMonthDay": {
          "type": "array", "minItems": 1,
          "items": { "type": "integer", "minimum": 1, "maximum": 31 }
        }
      },
      "required": ["@type", "frequency"],
      "additionalProperties": false
    },

    "Event": {
      "type": "object",
      "properties": {
        "@type": { "const": "Event" },
        "uid": { "$ref": "#/$defs/Uid" },
        "prodId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "created": { "$ref": "#/$defs/UTCDateTime" },
        "updated": { "$ref": "#/$defs/UTCDateTime" },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "description": "RFC 8984 revision counter. The LumbreCode exchange contract REQUIRES it on every exchanged event and requires it to increase monotonically per (source app, uid)."
        },

        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "descriptionContentType": {
          "type": "string",
          "pattern": "^text/[A-Za-z0-9!#$&^_.+-]+(;.*)?$"
        },

        "start": { "$ref": "#/$defs/LocalDateTime" },
        "duration": { "$ref": "#/$defs/Duration" },
        "timeZone": { "type": "string", "minLength": 1, "maxLength": 100 },
        "showWithoutTime": { "type": "boolean" },

        "status": {
          "enum": ["confirmed", "cancelled", "tentative"],
          "description": "The ONLY three values RFC 8984 registers for Event.status. This is the standard-conformant approximation any conforming reader gets. A producer lifecycle richer than this travels alongside it as the vendor extensions lumbrecode.de:statusCategory and lumbrecode.de:statusCode - on the OBJECT, not on the envelope, so it survives when a receiver stores only the JSCalendar object."
        },

        "lumbrecode.de:statusCategory": {
          "enum": ["tentative", "pending", "confirmed", "cancelled", "completed"],
          "description": "RFC 8984 section 3.3 vendor extension. The producer's exact lifecycle category, a closed vocabulary. Where it disagrees with `status`, this wins for a receiver that understands it. Mapping to `status`: tentative and pending map to tentative; completed maps to confirmed; the other two are identical."
        },
        "lumbrecode.de:statusCode": {
          "type": "string",
          "maxLength": 64,
          "description": "RFC 8984 section 3.3 vendor extension. Free source lifecycle code such as `planned` or `booked`, preserved verbatim and never interpreted."
        },

        "categories": {
          "type": "object",
          "minProperties": 1,
          "description": "URI-valued classification (RFC 8984). LumbreCode event types use the namespace https://lumbrecode.de/ns/event-type/<type>.",
          "propertyNames": { "type": "string", "format": "uri", "maxLength": 300 },
          "additionalProperties": { "const": true }
        },
        "keywords": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "type": "string", "minLength": 1, "maxLength": 100 },
          "additionalProperties": { "const": true }
        },
        "links": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/Link" }
        },
        "relatedTo": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/Uid" },
          "additionalProperties": { "$ref": "#/$defs/Relation" }
        },

        "recurrenceRules": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": { "$ref": "#/$defs/RecurrenceRule" }
        },
        "recurrenceId": { "$ref": "#/$defs/LocalDateTime" }
      },
      "required": ["@type", "uid", "updated", "title", "start"],
      "patternProperties": {
        "^[a-z0-9][a-z0-9.-]*\\.[a-z]{2,}:[A-Za-z0-9_]+$": {
          "$comment": "RFC 8984 section 3.3 vendor-specific property, e.g. lumbrecode.de:statusCategory. A receiver that does not know it keeps it verbatim and ignores it for behaviour."
        }
      },
      "additionalProperties": false
    }
  }
}
